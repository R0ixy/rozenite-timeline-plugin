{
  "name": "rozenite-timeline-plugin",
  "version": "0.1.0",
  "description": "A Rozenite plugin that adds a filterable, channel-based event timeline to React Native DevTools.",
  "keywords": [
    "rozenite",
    "rozenite-plugin",
    "react-native",
    "devtools",
    "timeline",
    "analytics",
    "logging"
  ],
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/r0ixy/rozenite-timeline-plugin.git"
  },
  "homepage": "https://github.com/r0ixy/rozenite-timeline-plugin#readme",
  "bugs": {
    "url": "https://github.com/r0ixy/rozenite-timeline-plugin/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rozenite build",
    "dev": "rozenite dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build",
    "verify:prod": "cd example && bun run export:prod && bun run export:dev && node ../scripts/verify-production-bundle.mjs dist/prod dist/dev"
  },
  "dependencies": {
    "@rozenite/agent-bridge": "^2.4.0",
    "@rozenite/plugin-bridge": "^2.4.0"
  },
  "devDependencies": {
    "@rozenite/testing": "^2.4.0",
    "@rozenite/ui": "^2.4.0",
    "@rozenite/vite-plugin": "^2.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "~19.1.10",
    "jsdom": "^26.1.0",
    "lucide-react": "^1.52.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.2",
    "rozenite": "^2.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "main": "./dist/react-native/cjs/react-native.js",
  "module": "./dist/react-native/react-native.js",
  "types": "./dist/react-native/react-native.d.ts",
  "exports": {
    ".": {
      "types": "./dist/react-native/react-native.d.ts",
      "import": "./dist/react-native/react-native.js",
      "require": "./dist/react-native/cjs/react-native.js"
    },
    "./package.json": "./package.json"
  }
}
